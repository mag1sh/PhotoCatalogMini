@model IEnumerable<PhotoCatalogMini.Data.Entities.Photo>
@{
	ViewData["Title"] = "Снимки";
}

<h1>Каталог на снимки</h1>

<a asp-action="Create" class="bnt bnt-primary mb-3">Добави нови снимки</a>

@if (!Model.Any())
{
	<p>Все още няма добавени снимки.</p>
}
else
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Заглавие</th>
				<th>Фотограф</th>
				<th>Категория</th>
				<th>Място на заснемане</th>
				<th>Описание</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var photo in Model)
			{
				<tr>
					<td>@photo.Title</td>
					<td>@photo.Photographer.Name</td>
					<td>@photo.Category.Name</td>
					<td>@photo.Location</td>
					<td>@photo.Description</td>
				</tr>
			}
		</tbody>
	</table>
}