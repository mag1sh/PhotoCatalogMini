<form method="post" action="photos/create">
    <div class="form-group">
        <label for="photo_title">Заглавие на снимката</label>
        <input type="text" class="form-control" name="title" id="photo_title" placeholder="Въведете заглавието на снимката тук">
        <small class="form-text text-muted">Въведете заглавието само на кирилица</small>
    </div>

    <div class="form-group">
        <label for="photo_photographer">Фотограф</label>
        <input type="text" class="form-control" name="photographer" id="photo_photographer">
    </div>

    <div class="form-group">
        <label for="photo_category">Категория</label>
        <input type="text" class="form-control" name="category" id="photo_category">
    </div>

    <div class="form-group">
        <label for="photo_location">Място на заснемане</label>
        <input type="text" class="form-control" name="location" id="photo_location">
    </div>

    <div class="form-group">
        <label for="photo_description">Описание</label>
        <input type="text" class="form-control" name="description" id="photo_description">
    </div>

    <button type="submit" class="btn btn-primary my-3">Запази</button>
</form>


zaglavie fotograf kategoriq mqsto na zasnemane opisanie